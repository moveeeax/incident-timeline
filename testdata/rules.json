{
 "status": "success",
 "data": {
  "groups": [
   {
    "name": "app",
    "file": "/etc/prometheus/rules/app.yml",
    "interval": 30,
    "rules": [
     {
      "type": "alerting",
      "name": "HighLatency",
      "query": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) > 1",
      "duration": 600,
      "labels": {
       "severity": "critical"
      },
      "annotations": {},
      "alerts": [],
      "health": "ok"
     },
     {
      "type": "alerting",
      "name": "CheckoutDown",
      "query": "up{job=\"checkout\"} == 0",
      "duration": 300,
      "labels": {
       "severity": "critical"
      },
      "annotations": {},
      "alerts": [],
      "health": "ok"
     },
     {
      "type": "recording",
      "name": "job:http_requests:rate5m",
      "query": "sum by (job) (rate(http_requests_total[5m]))",
      "health": "ok"
     }
    ]
   }
  ]
 }
}
